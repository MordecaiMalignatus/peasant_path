<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Peasant Path</title>
  <style>
    :root { color-scheme: light dark; }
    body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    h1 { margin-bottom: 0.25rem; }
    .masthead { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .issues-note { margin: 0; text-align: right; font-size: 0.8rem; }
    .muted { color: #888; font-size: 0.9rem; }
    .flash { background: #eef; border: 1px solid #99c; padding: 0.5rem 0.75rem; border-radius: 0.4rem; margin: 1rem 0; }
    form.inline { display: inline; }
    .pull { display: flex; align-items: center; gap: 0.75rem; margin: 1rem 0; }
    .story { border-top: 1px solid #ccc; padding: 0.75rem 0; }
    .story h3 { margin: 0 0 0.25rem; }
    .downloads .volume { margin-left: 0.1rem; }
    .downloads .branch { display: inline-block; width: 1.2rem; font-family: ui-monospace, monospace; color: #888; }
    .add { margin: 1.5rem 0; padding: 1rem; border: 1px solid #ccc; border-radius: 0.5rem; }
    .add input[type=text], .add input[type=url] { padding: 0.3rem; margin-right: 0.5rem; }
    button { padding: 0.35rem 0.75rem; cursor: pointer; }
    button.text-link { appearance: none; background: none; border: 0; color: inherit; cursor: pointer; font: inherit; padding: 0; text-decoration-line: underline; text-decoration-style: solid; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
    button.text-link:hover, button.text-link:focus-visible { color: LinkText; }
    .pending { color: #b80; }
    button.small { padding: 0.2rem 0.5rem; font-size: 0.8rem; }
    .rebuild-all { margin-top: 1.5rem; }
    .rename { display: inline-block; vertical-align: top; }
    .rename summary { cursor: pointer; }
    .rename form { margin: 0.35rem 0; }
    .rename input[type=text] { padding: 0.2rem; margin-right: 0.4rem; font-size: 0.85rem; }
  </style>
</head>
<body>
  <header class="masthead">
    <h1>Peasant Path</h1>
    <p class="muted issues-note">find an issue?<br><a href="https://github.com/mordecaimalignatus/peasant_path/issues">open an issue.</a></p>
  </header>
  <% if @flash %><div class="flash"><%= h(@flash) %></div><% end %>
  <%= yield %>
</body>
</html>
