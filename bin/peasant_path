#!/usr/bin/env ruby
# frozen_string_literal: true

# Run from a checkout, as the service units `peasant_path install` writes do,
# this file starts without Bundler: load the checkout's gems (including a
# vendor/bundle install) and code, whatever Gemfile the calling shell points
# at. An installed gem ships no Gemfile and needs none of it.
gemfile = File.expand_path("../Gemfile", __dir__)
if File.exist?(gemfile)
  ENV["BUNDLE_GEMFILE"] = gemfile
  require "bundler/setup"
  $LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
end

require "peasant_path"

PeasantPath::CLI.start(ARGV)
