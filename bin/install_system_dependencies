#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s\n\nInstalls ICU system libraries required by ffi-icu on Ubuntu or macOS,\nplus (when npm is available) the Playwright driver and Chromium used by the\noptional Patreon source.\n' "$0"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

case "$(uname -s)" in
  Darwin)
    if ! command -v brew >/dev/null 2>&1; then
      printf 'Homebrew is required on macOS: https://brew.sh\n' >&2
      exit 1
    fi

    brew install icu4c@78
    icu_prefix="$(brew --prefix icu4c@78)"

    printf '\nICU installed at %s\n' "$icu_prefix"
    printf 'For this shell, run:\n'
    printf '  export FFI_ICU_LIB="%s/lib"\n' "$icu_prefix"
    printf '  export DYLD_FALLBACK_LIBRARY_PATH="%s/lib:${DYLD_FALLBACK_LIBRARY_PATH:-}"\n' "$icu_prefix"
    ;;
  Linux)
    if [[ -r /etc/os-release ]]; then
      # shellcheck disable=SC1091
      . /etc/os-release
    fi

    if [[ "${ID:-}" != "ubuntu" && "${ID_LIKE:-}" != *ubuntu* && "${ID_LIKE:-}" != *debian* ]]; then
      printf 'This script supports Ubuntu/Debian-like Linux systems. Install ICU development headers manually.\n' >&2
      exit 1
    fi

    sudo apt-get update
    sudo apt-get install -y libicu-dev
    ;;
  *)
    printf 'Unsupported OS: %s\n' "$(uname -s)" >&2
    exit 1
    ;;
esac

# Optional: Patreon support drives a real Chromium through Playwright. The
# Ruby gem needs the matching Node driver (pinned in package.json) and a
# browser download. RoyalRoad-only setups can skip this entirely.
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
if command -v npm >/dev/null 2>&1; then
  printf '\nInstalling the Playwright driver and Chromium for Patreon support...\n'
  (cd "$repo_root" && npm install && ./node_modules/.bin/playwright-core install --no-shell chromium)
  if [[ "$(uname -s)" == "Linux" ]]; then
    # Chromium needs a set of shared libraries that a bare server lacks.
    (cd "$repo_root" && sudo ./node_modules/.bin/playwright-core install-deps chromium)
  fi
else
  printf '\nnpm not found: skipping Playwright/Chromium. Patreon stories will not work until you\n'
  printf 'install Node and run: npm install && ./node_modules/.bin/playwright-core install --no-shell chromium\n'
fi

printf '\nSystem dependencies installed. Run bundle install next.\n'
